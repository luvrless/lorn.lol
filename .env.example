# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lorn_lol?schema=public"

# Auth
NEXTAUTH_SECRET="your-super-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Discord OAuth
DISCORD_CLIENT_ID="1460381998051889225"
DISCORD_CLIENT_SECRET="your_discord_client_secret"
DISCORD_BOT_TOKEN="your_discord_bot_token"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# UploadThing (for file uploads)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# S3-compatible storage (alternative to UploadThing)
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_REGION="auto"
S3_PUBLIC_URL=""

# Redis (for caching, rate limiting, sessions)
REDIS_URL="redis://localhost:6379"

# Stripe (for premium subscriptions)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""

# Email (for verification, password reset)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@lorn.lol"

# Analytics
ANALYTICS_SECRET=""

# Security
ENCRYPTION_KEY="" # 32-char key for encrypting sensitive data
RATE_LIMIT_WINDOW_MS="900000" # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100"

# Feature flags
ENABLE_REGISTRATION="true"
ENABLE_DISCORD_OAUTH="true"
ENABLE_GOOGLE_OAUTH="false"
ENABLE_PREMIUM="true"
ENABLE_TEMPLATES="true"
ENABLE_INTEGRATIONS="true"
ENABLE_ANALYTICS="true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="LORN.LOL"